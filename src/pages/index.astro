---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getProjects } from '../lib-projects';
import { site } from '../site';
import { url } from '../lib-url';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const count = (st: string) => projects.filter((p) => p.data.status === st).length;
const summary = [
  ['running', 'running'], ['measured', 'measured'], ['design-complete', 'design complete'], ['in-progress', 'in progress'],
].map(([k, l]) => ({ k, l, n: count(k) })).filter((x) => x.n > 0);
---
<Base>
  <section class="relative pt-20 pb-16 sm:pt-28">
    <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <p class="mb-5 font-mono text-sm text-accent">$ whoami</p>
    <h1 class="max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight text-text sm:text-7xl">{site.tagline.split('|').map((l, i) => <span class:list={['block', i === 1 && 'text-accent']}>{l}</span>)}</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">{site.intro}</p>
    <ul class="mt-6 flex flex-wrap gap-2 font-mono text-xs">
      {site.specialties.map((t) => <li class="rounded-full border border-line bg-panel px-3 py-1 text-muted">{t}</li>)}
    </ul>
    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted">
      <li class="text-text">{projects.length} projects</li>
      {summary.map((x) => <li class={`tone-${x.k} flex items-center gap-2`}><span class="h-1.5 w-1.5 rounded-full bg-[color:var(--tone)]"></span>{x.n} {x.l}</li>)}
    </ul>
    <div class="mt-8 flex flex-wrap gap-4 font-mono text-sm">
      <a href={url('/projects/')} class="rounded-lg border border-accent/60 px-4 py-2 text-accent no-underline hover:bg-accent/10">Projects <span class="ml-1 text-muted">Explore engineering work</span></a>
      <a href={site.github} class="rounded-lg border border-line px-4 py-2 text-muted no-underline hover:text-text">GitHub <span class="ml-1 text-muted/70">Source and development</span></a>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-4 font-mono text-xs uppercase tracking-[0.15em] text-muted">Currently</h2>
    <ul class="space-y-2 text-sm">
      {site.currently.map((c) => (
        <li class="flex gap-3">
          <span class="select-none font-mono text-accent">&gt;</span>
          <span class="text-muted">
            {c.href ? <a href={url(c.href)} class="font-medium text-text no-underline hover:text-accent">{c.label}</a> : <span class="font-medium text-text">{c.label}</span>}
            <span class="ml-2">{c.text}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="mb-6 font-mono text-xs uppercase tracking-[0.15em] text-muted">Featured</h2>
    <div class="grid gap-5 md:grid-cols-1">
      {featured.map((p) => <ProjectCard project={p} large />)}
    </div>
  </section>

  {others.length > 0 && (
    <section class="mt-16">
      <h2 class="mb-6 font-mono text-xs uppercase tracking-[0.15em] text-muted">Also built</h2>
      <ul class="divide-y divide-line rounded-xl border border-line bg-panel">
        {others.map((p) => (
          <li>
            <a href={url(`/projects/${p.id}/`)} class="flex flex-col items-start gap-2 px-5 py-4 no-underline hover:bg-white/[0.03] sm:flex-row sm:justify-between sm:gap-4">
              <span class="flex-1">
                <span class="block font-medium text-text">{p.data.title}</span>
                <span class="block text-sm text-muted">{p.data.pitch}</span>
              </span>
              <span class="order-first shrink-0 pt-0.5 sm:order-none"><StatusBadge status={p.data.status} /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-16 rounded-xl border border-line p-6 text-sm text-muted">
    <p class="mb-3 font-mono text-xs uppercase tracking-[0.15em]">How to read the badges</p>
    <p>Each project has a label for where it really stands today, so a design doc doesn't get mistaken for something that runs.</p>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
      <div class="flex items-center gap-3"><StatusBadge status="running" /> works end to end</div>
      <div class="flex items-center gap-3"><StatusBadge status="measured" /> tested, with results</div>
      <div class="flex items-center gap-3"><StatusBadge status="design-complete" /> designed, not built yet</div>
      <div class="flex items-center gap-3"><StatusBadge status="in-progress" /> being built</div>
    </div>
  </section>
</Base>
