---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---
<Base title="About">
  <section class="max-w-2xl pt-14">
    <h1 class="text-3xl font-semibold text-text">About</h1>
    <div class="prose mt-6">
      <p>I'm Furqan, a third-year computer science student at FAST NUCES in Karachi. My focus is systems engineering, with security layered on top: I'm more interested in how a system is built so that it holds up than in breaking other people's.</p>
      <p>Most of my work is in C and C++, with Python and Go where they fit.</p>
      <p>I'm looking for a remote internship in backend, systems or infrastructure engineering.</p>
      <h2>Contact</h2>
      <p><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.github}>github.com/Furqan-2006</a></p>
    </div>
  </section>
</Base>
