---
import { site } from '../site';
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-5 py-8 font-mono text-xs text-muted sm:px-8">
    <span>© {new Date().getFullYear()} {site.fullName}</span>
    <span class="flex gap-5">
      <a href={site.github} class="no-underline hover:text-accent">github</a>
      <a href={`mailto:${site.email}`} class="no-underline hover:text-accent">email</a>
    </span>
  </div>
</footer>
