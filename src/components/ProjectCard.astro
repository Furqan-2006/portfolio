---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import { url } from '../lib-url';
interface Props { project: CollectionEntry<'projects'>; large?: boolean; }
const { project, large = false } = Astro.props;
const d = project.data;
---
<a href={url(`/projects/${project.id}/`)} data-status={d.status} data-tags={d.tags.join(',')}
   class:list={[`tone-${d.status} card-accent project-card group block rounded-xl border border-line bg-panel no-underline transition hover:border-[color:var(--tone)]/50`, large ? 'p-6' : 'p-5']}>
  <div class="mb-3 flex items-start justify-between gap-3">
    <h3 class:list={['font-semibold text-text group-hover:text-accent', large ? 'text-xl' : 'text-lg']}>{d.title}</h3>
    <StatusBadge status={d.status} />
  </div>
  <p class="mb-4 text-sm text-muted">{d.pitch}</p>
  {d.metrics[0] && (
    <p class="mb-4 flex items-baseline gap-2 text-sm"><span class="font-mono text-lg text-[color:var(--tone)]">{d.metrics[0].value}</span><span class="text-text">{d.metrics[0].label}</span></p>
  )}
  <p class="font-mono text-xs text-muted/80">{d.stack.join(' · ')}</p>
  <p class="mt-4 flex items-end justify-between gap-4 font-mono text-xs text-muted">
    <span>{d.context}</span>
    <span class="shrink-0 text-[color:var(--tone)] transition group-hover:translate-x-1"><span class="hidden sm:inline">read case study </span>→</span>
  </p>
</a>
